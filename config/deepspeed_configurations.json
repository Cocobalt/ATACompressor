{
    "zero_optimization": {
        "stage": 2,
        "overlap_comm": true,
        "contiguous_gradients": true
    },
    "gradient_accumulation_steps": 4,
    "gradient_clipping": "auto",
    "steps_per_print": 2000,
    "train_micro_batch_size_per_gpu": 1,
    "wall_clock_breakdown": false,
    "fp16": {
        "enabled": true, 
        "initial_scale_power": 8, 
        "loss_scale": 0, 
        "loss_scale_window": 200,
        "hysteresis": 2,
        "min_loss_scale": 1,
        "auto_cast": true
        
    },
    "optimizer": {
        "type": "AdamW",  
        "params": {
            "lr": "auto",
            "betas": [0.9, 0.999],
            "eps": 1e-8,
            "weight_decay": 0.2
        }
    }
}
